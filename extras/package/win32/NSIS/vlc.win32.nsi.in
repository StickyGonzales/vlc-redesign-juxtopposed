;;;;;;;;;;;;;;;;;;;;;;;
; Macro and Functions ;
;;;;;;;;;;;;;;;;;;;;;;;

!include helpers\registry.nsh
!include helpers\extensions.nsh
!include helpers\install.nsh
!include helpers\utils.nsh

;;;;;;;;;;;;;;;;;;;;;;
; Installer sections ;
; The CORE of the    ;
; installer          ;
;;;;;;;;;;;;;;;;;;;;;;

${MementoSection} "$(Name_Section01)" SEC01
  SectionIn 1 2 3 RO
  SetShellVarContext all
  SetOutPath "$INSTDIR"

  DetailPrint "$(Detail_CheckProcesses)"
  Call CheckRunningProcesses

  ; Remove 32 bit version first
  !ifdef VLC_64BIT_INSTALLER
  ${If} $32bitPath != ""
    ; Run uninstaller
    ClearErrors
    ExecWait '"$32bitUninstaller" /S _?=$32bitPath'

    ; If uninstall was not successfull, do not continue.
    ; This happens for example if the user cancels the uninstaller.
    ${If} ${Errors}
      Goto skip_uninstall32_cleanup
    ${EndIf}

    ${If} ${FileExists} "$32bitUninstaller"
      Delete "$32bitUninstaller"
      RMDir "$32bitPath"
    ${EndIf}
  ${EndIf}
  !endif

skip_uninstall32_cleanup:

  ; Remove previous version first, if this is update
  ${If} $ReinstallType == "1"
    FileOpen $UninstallLog "$INSTDIR\uninstall.log" r
    UninstallLoop:
      ClearErrors
      FileRead $UninstallLog $R0
      IfErrors UninstallEnd
      Push $R0
      Call TrimNewLines
      Pop $R0
      Delete "$INSTDIR\$R0"
      Goto UninstallLoop
    UninstallEnd:
    FileClose $UninstallLog
    Delete "$INSTDIR\uninstall.log"
    Delete "$INSTDIR\uninstall.exe"
    Push "\"
    Call RemoveEmptyDirs
  ${EndIf}

!if "${PRODUCT_PROGID}" != "VLC"
!if "${PRODUCT_BETA_NAME}" != "${PRODUCT_NAME}"
  ; redesign: brand layer, an upgrade from a Cone 0.x beta (redesign/RENAME_CONE_PLAYER.md): its
  ; shortcuts and website link carry the old name; they go whichever sections are picked now
  Delete "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_BETA_NAME}.lnk"
  Delete "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_BETA_NAME} skinned.lnk"
  Delete "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_BETA_NAME} Website.lnk"
  Delete "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_BETA_NAME} - reset preferences and cache files.lnk"
  Delete "$DESKTOP\${PRODUCT_BETA_NAME}.lnk"
  Delete "$INSTDIR\${PRODUCT_BETA_NAME} Website.url"
!endif
!endif

  !insertmacro OpenUninstallLog

  ; VLC.exe, libvlc.dll
  !insertmacro InstallFile ${PRODUCT_EXE}
  !insertmacro InstallFile vlc-cache-gen.exe
  !insertmacro InstallFile vlc-preparser.exe

  ; All dlls
  !insertmacro InstallFile *.dll

  ; Text files
  !insertmacro InstallFile *.txt

  ; Subfolders
  !insertmacro InstallFolder plugins
@HAVE_NLS_TRUE@ !insertmacro InstallFolderOptional locale
  !insertmacro InstallFolder hrtfs
@BUILD_SKINS_TRUE@   !insertmacro InstallFolder skins
@BUILD_LUA_TRUE@     !insertmacro InstallFolder lua

  ; Generate the cache and add it to uninstall.log
  nsExec::ExecToStack '"$INSTDIR\vlc-cache-gen.exe" $INSTDIR\plugins'
  FindFirst $0 $1 "$INSTDIR\plugins\*.dat"
  FileWrite $UninstallLog "plugins\$1$\r$\n"
  FindClose $0


  ; URLs
  WriteIniStr "$INSTDIR\${PRODUCT_WEBSITE_LINK}.url" "InternetShortcut" "URL" "${PRODUCT_WEB_SITE}"
  FileWrite $UninstallLog "${PRODUCT_WEBSITE_LINK}.url$\r$\n"
  WriteIniStr "$INSTDIR\Documentation.url" "InternetShortcut" "URL" "${PRODUCT_DOC_URL}"
  FileWrite $UninstallLog "Documentation.url$\r$\n"
!if "${PRODUCT_PROGID}" == "VLC"
  WriteIniStr "$INSTDIR\New_Skins.url" "InternetShortcut" "URL" "${PRODUCT_SKINS_URL}"
  FileWrite $UninstallLog "New_Skins.url$\r$\n"
!endif

  !insertmacro CloseUninstallLog

!if "${PRODUCT_PROGID}" != "VLC"
  ; redesign: brand layer, the record of the registry keys and values the installer adds, which
  ; the uninstaller removes (helpers/registry.nsh, INSTALLER_NOTES.md section 7)
  !insertmacro ConeRegOpenRecord
  Call ConeRegAdoptOwnKeys
!endif

  ; Add VLC to "recommended programs" for the following extensions
  !insertmacro RegClassesOwnStr "Applications\${PRODUCT_EXE}" "" "" ""
  !insertmacro RegClassesOwnStr "Applications\${PRODUCT_EXE}" "" "FriendlyAppName" "${PRODUCT_NAME}"
  !insertmacro RegClassesOwnStr "Applications\${PRODUCT_EXE}" "shell\Open" "" "$(ContextMenuEntry_PlayWith)"
  !insertmacro RegClassesOwnStr "Applications\${PRODUCT_EXE}" "shell\Open\command" "" '"$INSTDIR\${PRODUCT_EXE}" --started-from-file "%1"'
!if "${PRODUCT_PROGID}" != "VLC"
  ; redesign: brand layer, the list is written anew: an earlier installer of this app wrote one
  ; stray value there (VLC's $0, see RegisterExtension), which an upgrade would keep; only when
  ; an earlier install made it (its own key, in the record)
  ${If} $ConeRegAdopt == 1
    DeleteRegKey HKLM "Software\Classes\Applications\${PRODUCT_EXE}\SupportedTypes"
  ${EndIf}
!endif
  !insertmacro MacroAllExtensions RegisterExtensionMacro
@BUILD_SKINS_TRUE@   !insertmacro MacroSkinExtensions RegisterSkinExtensionMacro

  ; Add VLC to "App Paths" to run VLC from ShellExecute/ShellExecuteEx/run dialog without giving a full path
  !insertmacro RegOwnStr "Software\Microsoft\Windows\CurrentVersion\App Paths\${PRODUCT_EXE}" "" "" "$INSTDIR\${PRODUCT_EXE}"
  !insertmacro RegOwnStr "Software\Microsoft\Windows\CurrentVersion\App Paths\${PRODUCT_EXE}" "" "Path" "$INSTDIR"

  ; Windows default programs Registration
  ; Vista and above detection
  ${If} ${AtLeastWinVista}
    !insertmacro RegSharedStr "Software\RegisteredApplications" "${PRODUCT_PROGID}" "Software\Clients\Media\${PRODUCT_PROGID}\Capabilities"
    !insertmacro RegOwnStr "Software\Clients\Media\${PRODUCT_PROGID}" "Capabilities" "ApplicationName" "${PRODUCT_NAME}"
    !insertmacro RegOwnStr "Software\Clients\Media\${PRODUCT_PROGID}" "Capabilities" "ApplicationDescription" "${PRODUCT_DESCRIPTION}"
    !insertmacro RegOwnStr "Software\Clients\Media\${PRODUCT_PROGID}" "" "" "${PRODUCT_NAME}"
!if "${PRODUCT_PROGID}" == "VLC"
    WriteRegStr HKLM "Software\Clients\Media\${PRODUCT_PROGID}\InstallInfo" "HideIconsCommand" "$\"$INSTDIR\spad-setup.exe$\" /HideIcons /S"
    WriteRegStr HKLM "Software\Clients\Media\${PRODUCT_PROGID}\InstallInfo" "ShowIconsCommand" "$\"$INSTDIR\spad-setup.exe$\" /ShowIcons /S"
    WriteRegStr HKLM "Software\Clients\Media\${PRODUCT_PROGID}\InstallInfo" "ReinstallCommand" "$\"$INSTDIR\spad-setup.exe$\" /Reinstall /S"
    WriteRegDWORD HKLM "Software\Clients\Media\${PRODUCT_PROGID}\InstallInfo" "IconsVisible" 0x001
!endif
  ${EndIf}
${MementoSectionEnd}

${MementoSection} "$(Name_Section02a)" SEC02a
  SectionIn 1 2 3
  CreateDirectory "$SMPROGRAMS\${PRODUCT_PUBLISHER}"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_NAME}.lnk" \
    "$INSTDIR\${PRODUCT_EXE}" ""
!if "${PRODUCT_PROGID}" == "VLC"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_NAME} skinned.lnk" \
    "$INSTDIR\${PRODUCT_EXE}" "-Iskins"
!else
  ; redesign: brand layer (Decision 63), Cone has no skins interface; an earlier test install's
  ; skinned shortcut goes away on upgrade
  Delete "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_NAME} skinned.lnk"
!endif
  CreateShortCut "$SMPROGRAMS\${PRODUCT_PUBLISHER}\Documentation.lnk" \
    "$INSTDIR\Documentation.url"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_PUBLISHER}\Release Notes.lnk" \
    "$INSTDIR\NEWS.txt" ""
  CreateShortCut "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_WEBSITE_LINK}.lnk" \
    "$INSTDIR\${PRODUCT_WEBSITE_LINK}.url"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_PUBLISHER}\${PRODUCT_NAME} - reset preferences and cache files.lnk" \
    "$INSTDIR\${PRODUCT_EXE}" "--reset-config --reset-plugins-cache vlc://quit"
${MementoSectionEnd}

${MementoSection} "$(Name_Section02b)" SEC02b
  SectionIn 1 2 3
  CreateShortCut "$DESKTOP\${PRODUCT_NAME}.lnk" \
    "$INSTDIR\${PRODUCT_EXE}" ""
${MementoSectionEnd}

!if "${PRODUCT_PROGID}" != "VLC"
; redesign: brand layer, an upgrade or reinstall with "Create a desktop shortcut" unticked leaves
; no desktop shortcut (#73, redesign/FIX_UPGRADE_SHORTCUT_NOTES.md): the box starts in the
; install's current state (.onInit), so unticking it means "remove it"
Section "-DesktopShortcutOff"
  SectionIn 1 2 3 RO
  ${IfNot} ${SectionIsSelected} ${SEC02b}
  ${AndIf} $PreviousVersion != ""
    Delete "$DESKTOP\${PRODUCT_NAME}.lnk"
  ${EndIf}
SectionEnd
!endif

!ifdef INSTALL_ACTIVEX
SectionGroup /e "!$(Name_Section34)"

${MementoSection} "$(Name_Section04)" SEC04
  SectionIn 1 3

  SetOutPath "$INSTDIR"
  !insertmacro OpenUninstallLog
  !insertmacro InstallFile axvlc.dll
  !insertmacro CloseUninstallLog
@HAVE_WIN64_FALSE@ RegDLL "$INSTDIR\axvlc.dll"
@HAVE_WIN64_TRUE@  ExecWait '"$SYSDIR\regsvr32.exe" /s "$INSTDIR\axvlc.dll"'
${MementoSectionEnd}
SectionGroupEnd
!endif


; redesign: brand layer, one AutoPlay handler: this app's value in the shared event key EVENT and
; its own handler key (registry.nsh)
!macro AutoplayHandler EVENT HANDLER ACTION PROGID
  !insertmacro RegSharedStr "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\${EVENT}" "${PRODUCT_PROGID}${HANDLER}" ""
  !insertmacro RegOwnStr "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}${HANDLER}" "" "Action" "${ACTION}"
  !insertmacro RegOwnStr "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}${HANDLER}" "" "DefaultIcon" '"$INSTDIR\${PRODUCT_EXE}",0'
  !insertmacro RegOwnStr "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}${HANDLER}" "" "InvokeProgID" "${PRODUCT_PROGID}.${PROGID}"
  !insertmacro RegOwnStr "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}${HANDLER}" "" "InvokeVerb" "Open"
  !insertmacro RegOwnStr "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}${HANDLER}" "" "Provider" "${PRODUCT_PUBLISHER} ${PRODUCT_NAME}"
!macroend

; redesign: brand layer, uninstall: this app's value in the shared event key EVENT (a value only)
!macro ConeUnAutoplayEventValue EVENT HANDLER
  DeleteRegValue HKLM "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\${EVENT}" "${PRODUCT_PROGID}${HANDLER}"
!macroend

; redesign: brand layer, one AutoPlay ProgID (its own class key); ARGS: the command line after the exe
!macro AutoplayProgID PROGID DESCRIPTION ARGS
  !insertmacro RegClassesOwnStr "${PRODUCT_PROGID}.${PROGID}" "" "" "${PRODUCT_PROGID} ${DESCRIPTION}"
  !insertmacro RegClassesOwnStr "${PRODUCT_PROGID}.${PROGID}" "shell" "" "Open"
  !insertmacro RegClassesOwnStr "${PRODUCT_PROGID}.${PROGID}" "shell\Open\command" "" '"$INSTDIR\${PRODUCT_EXE}" ${ARGS}'
  !insertmacro RegClassesOwnStr "${PRODUCT_PROGID}.${PROGID}" "DefaultIcon" "" '"$INSTDIR\${PRODUCT_EXE}",0'
!macroend

${MementoSection} "$(Name_Section05)" SEC05
  SectionIn 1 2 3
  ; the verb is an own key under the shared AudioCD\shell and DVD\shell
  !insertmacro RegClassesOwnStr "AudioCD\shell\PlayWith${PRODUCT_PROGID}" "" "" "$(ContextMenuEntry_PlayWith)"
  !insertmacro RegClassesOwnStr "AudioCD\shell\PlayWith${PRODUCT_PROGID}" "command" "" \
    '"$INSTDIR\${PRODUCT_EXE}" --started-from-file cdda:///%1'
  !insertmacro RegClassesOwnStr "DVD\shell\PlayWith${PRODUCT_PROGID}" "" "" "$(ContextMenuEntry_PlayWith)"
  !insertmacro RegClassesOwnStr "DVD\shell\PlayWith${PRODUCT_PROGID}" "command" "" \
    '"$INSTDIR\${PRODUCT_EXE}" --started-from-file dvd:///%1'

  !insertmacro AutoplayHandler PlayDVDMovieOnArrival PlayDVDMovieOnArrival "$(Action_OnArrivalDVD)" DVDMovie
  !insertmacro AutoplayHandler PlayCDAudioOnArrival PlayCDAudioOnArrival "$(Action_OnArrivalAudioCD)" CDAudio
  !insertmacro AutoplayHandler PlayVideoCDMovieOnArrival PlayVCDMovieOnArrival "$(Action_OnArrivalVCDMovie)" VCDMovie
  !insertmacro AutoplayHandler PlaySuperVideoCDMovieOnArrival PlaySVCDMovieOnArrival "$(Action_OnArrivalSVCDMovie)" SVCDMovie
  !insertmacro AutoplayHandler PlayDVDAudioOnArrival PlayDVDAudioOnArrival "$(Action_OnArrivalDVDAudio)" OPENFolder
  !insertmacro AutoplayHandler PlayVideoFilesOnArrival PlayVideoFilesOnArrival "$(Action_OnArrivalVideoFiles)" OPENFolder
  !insertmacro AutoplayHandler PlayMusicFilesOnArrival PlayMusicFilesOnArrival "$(Action_OnArrivalMusicFiles)" OPENFolder
  !insertmacro AutoplayHandler PlayBlurayOnArrival PlayBlurayOnArrival "$(Action_OnArrivalBluray)" Bluray

  !insertmacro AutoplayProgID DVDMovie "DVD Movie" "--started-from-file dvd:///%1"
  !insertmacro AutoplayProgID CDAudio "CD Audio" "--started-from-file cdda:///%1"
  !insertmacro AutoplayProgID VCDMovie "VCD Movie" "--started-from-file vcd:///%1"
  !insertmacro AutoplayProgID SVCDMovie "SVCD Movie" "--started-from-file vcd:///%1"
  !insertmacro AutoplayProgID OPENFolder "Play content" "%1"
  !insertmacro AutoplayProgID Bluray "Bluray" "--started-from-file bluray:///%1"

${MementoSectionEnd}


SectionGroup /e "!$(Name_Section06)" SEC06
  SectionGroup "$(Name_SectionGroupAudio)"
    !insertmacro MacroAudioExtensions AssociateExtensionSection
  SectionGroupEnd
  SectionGroup "$(Name_SectionGroupVideo)"
    !insertmacro MacroVideoExtensions AssociateExtensionSection
  SectionGroupEnd
  SectionGroup "$(Name_SectionGroupOther)"
    !insertmacro MacroOtherExtensions AssociateExtensionSection
!if "${PRODUCT_PROGID}" == "VLC"
    !insertmacro MacroSkinExtensions AssociateSkinExtensionSection
!endif
    !insertmacro MacroUnassociatedExtensions AssociateExtensionUnselectedSection
  SectionGroupEnd
SectionGroupEnd

${MementoSection} "$(Name_Section07)" SEC07
  SectionIn 1 3
  !insertmacro MacroAllExtensions AddContextMenu
!if "${PRODUCT_PROGID}" != "VLC"
  !insertmacro ConeAddDirectoryContextMenu
!else
  !insertmacro AddContextMenuExt "Directory"
!endif
${MementoSectionEnd}

${MementoUnselectedSection} "$(Name_Section08)" SEC08
  !insertmacro delprefs
${MementoSectionEnd}

${MementoSectionDone}

; Installer section descriptions
!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC01} "$(Desc_Section01)"
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC02a} "$(Desc_Section02a)"
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC02b} "$(Desc_Section02b)"
!ifdef INSTALL_ACTIVEX
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC04} "$(Desc_Section04)"
!endif
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC05} "$(Desc_Section05)"
!if "${PRODUCT_PROGID}" != "VLC"
  ; redesign: brand layer, the file types are offered, never taken over (INSTALLER_NOTES.md);
  ; in English for every language
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC06} "Lists ${PRODUCT_NAME} in Open with and Default apps for these file types; your default app stays."
!else
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC06} "$(Desc_Section06)"
!endif
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC07} "$(Desc_Section07)"
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC08} "$(Desc_Section08)"
!insertmacro MUI_FUNCTION_DESCRIPTION_END


;;; Start function
Function .onInit

@HAVE_WIN64_TRUE@ SetRegView 64

${MementoSectionRestore}

@HAVE_WIN64_TRUE@ !include "x64.nsh"
@HAVE_WIN64_TRUE@ ${Unless} ${RunningX64}
@HAVE_WIN64_TRUE@    MessageBox MB_OK|MB_ICONSTOP "This version of ${PRODUCT_SHORT_NAME} only runs on 64-bit operating systems.$\nPlease get the 32-bit version and try again."
@HAVE_WIN64_TRUE@    Quit
@HAVE_WIN64_TRUE@ ${EndUnless}
${IfNot} ${AtLeastWin7}
    Goto WinTooOld
${Endif}

ReadRegStr $INSTDIR HKLM "${PRODUCT_DIR_REGKEY}" "InstallDir"
StrCmp $INSTDIR "" 0 WinOk
StrCpy $INSTDIR "$@PROGRAMFILES@\${PRODUCT_INSTALL_DIR}"
Goto WinOk

WinTooOld:
    MessageBox MB_OK|MB_ICONSTOP "This version of ${PRODUCT_SHORT_NAME} only runs on Windows 7 and newer."
    Quit

WinOk:
  ; /update argument
  Call ParseCommandline

  ; See if a other bitness VLC version exists
  !ifdef VLC_64BIT_INSTALLER
    SetRegView 32

    Call ReadPreviousVersion

    ${If} $PreviousVersion != ""
      ReadRegStr $32bitUninstaller ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "UninstallString"
      ReadRegStr $32bitPath ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "InstallLocation"
      StrCpy $PreviousVersion ""
    ${EndIf}

    SetRegView lastused
  !endif

  ; See if previous version exists
  Call ReadPreviousVersion

  ${If} $PreviousVersion == ""
    StrCpy $PerformUpdate 0
  ${Else}
    Push "${VERSION}"
    Push $PreviousVersion
    Call VersionCompare

    ${If} $PreviousVersionState != "newer"
      StrCpy $PerformUpdate 0
    ${EndIf}
  ${EndIf}

!if "${PRODUCT_PROGID}" != "VLC"
  ; redesign: brand layer, on an upgrade or reinstall "Create a desktop shortcut" (the Desktop
  ; shortcut component) starts in the state of the install as it is now: ticked only while a
  ; Cone Player desktop shortcut exists (#73). Memento restores the choice of the last install,
  ; so a shortcut the user deleted since came back on every upgrade, the silent one (/S)
  ; included. A fresh install keeps the default (ticked)
  ${If} $PreviousVersion != ""
    Call DesktopShortcutExists
    Pop $0
    ${If} $0 == 1
      !insertmacro SelectSection ${SEC02b}
    ${Else}
      !insertmacro UnselectSection ${SEC02b}
    ${EndIf}
  ${EndIf}
!endif

  !insertmacro MUI_LANGDLL_DISPLAY

FunctionEnd

;;; Page to upgrade / downgrade or customize the installation
Function PageReinstall
  ${If} $PreviousVersion == ""
    Abort
  ${EndIf}

  ${If} $PerformUpdate == 1
    StrCpy $ReinstallType 1
    Abort
  ${EndIf}

  nsDialogs::Create /NOUNLOAD 1018
  Pop $0

  ${If} $PreviousVersionState == "newer"

    !insertmacro MUI_HEADER_TEXT "$(Reinstall_Headline)" "$(Reinstall_HeadlineInstall)"
    nsDialogs::CreateItem /NOUNLOAD STATIC ${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS} 0 0 0 100% 40 "$(Reinstall_MessageOlder)"
    Pop $R0
    nsDialogs::CreateItem /NOUNLOAD BUTTON ${BS_AUTORADIOBUTTON}|${BS_VCENTER}|${BS_MULTILINE}|${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS}|${WS_GROUP}|${WS_TABSTOP} 0 10 55 100% 30 "$(Reinstall_OptionUpgrade)"
    Pop $ReinstallUninstallBtn
    nsDialogs::CreateItem /NOUNLOAD BUTTON ${BS_AUTORADIOBUTTON}|${BS_TOP}|${BS_MULTILINE}|${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS} 0 10 85 100% 50 "$(Reinstall_OptionAdvanced)"
    Pop $R0

    ${If} $ReinstallType == ""
      StrCpy $ReinstallType 1
    ${EndIf}

  ${ElseIf} $PreviousVersionState == "older"

    !insertmacro MUI_HEADER_TEXT "$(Reinstall_Headline)" "$(Reinstall_HeadlineInstall)"
    nsDialogs::CreateItem /NOUNLOAD STATIC ${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS} 0 0 0 100% 40 "$(Reinstall_MessageNewer)"
    Pop $R0
    nsDialogs::CreateItem /NOUNLOAD BUTTON ${BS_AUTORADIOBUTTON}|${BS_VCENTER}|${BS_MULTILINE}|${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS}|${WS_GROUP}|${WS_TABSTOP} 0 10 55 100% 30 "$(Reinstall_OptionDowngrade)"
    Pop $ReinstallUninstallBtn
    nsDialogs::CreateItem /NOUNLOAD BUTTON ${BS_AUTORADIOBUTTON}|${BS_TOP}|${BS_MULTILINE}|${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS} 0 10 85 100% 50 "$(Reinstall_OptionAdvanced)"
    Pop $R0

    ${If} $ReinstallType == ""
      StrCpy $ReinstallType 1
    ${EndIf}

  ${ElseIf} $PreviousVersionState == "same"

    !insertmacro MUI_HEADER_TEXT "$(Reinstall_Headline)" "$(Reinstall_HeadlineMaintenance)"
    nsDialogs::CreateItem /NOUNLOAD STATIC ${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS} 0 0 0 100% 40 "$(Reinstall_MessageSame)"
    Pop $R0
    nsDialogs::CreateItem /NOUNLOAD BUTTON ${BS_AUTORADIOBUTTON}|${BS_VCENTER}|${BS_MULTILINE}|${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS}|${WS_GROUP}|${WS_TABSTOP} 0 10 55 100% 30 "$(Reinstall_OptionComponents)"
    Pop $R0
    nsDialogs::CreateItem /NOUNLOAD BUTTON ${BS_AUTORADIOBUTTON}|${BS_TOP}|${BS_MULTILINE}|${WS_VISIBLE}|${WS_CHILD}|${WS_CLIPSIBLINGS} 0 10 85 100% 50 "$(Reinstall_OptionUninstall)"
    Pop $ReinstallUninstallBtn

    ${If} $ReinstallType == ""
      StrCpy $ReinstallType 2
    ${EndIf}

  ${Else}

    MessageBox MB_ICONSTOP "Unknown value of PreviousVersionState, aborting" /SD IDOK
    Abort

  ${EndIf}

  ${If} $ReinstallType == "1"
    SendMessage $ReinstallUninstallBtn ${BM_SETCHECK} 1 0
  ${Else}
    SendMessage $R0 ${BM_SETCHECK} 1 0
  ${EndIf}

  nsDialogs::Show

FunctionEnd

Function PageLeaveReinstall

  SendMessage $ReinstallUninstallBtn ${BM_GETCHECK} 0 0 $R0
  ${If} $R0 == 1
    ; Option to uninstall old version selected
    StrCpy $ReinstallType 1
  ${Else}
    ; Custom up/downgrade or add/remove/reinstall
    StrCpy $ReinstallType 2
  ${EndIf}

  ${If} $ReinstallType == 1

    ${If} $PreviousVersionState == "same"

!if "${PRODUCT_PROGID}" != "VLC"
      ; redesign: brand layer, an install without a registry record was made by an older
      ; installer, whose uninstaller removes keys that are not its own (INSTALLER_NOTES.md
      ; section 7): reinstall first, so this version's uninstaller does it
      ${IfNot} ${FileExists} "$INSTDIR\${CONE_REG_RECORD}"
        MessageBox MB_OK|MB_ICONINFORMATION "This ${PRODUCT_NAME} was installed by an older installer. Choose $\"$(Reinstall_OptionComponents)$\" first; then uninstall ${PRODUCT_NAME} from Settings > Apps." /SD IDOK
        Abort
      ${EndIf}
!endif
      Call RunUninstaller
      Quit

    ${EndIf}

  ${EndIf}

FunctionEnd

Function RunUninstaller
  ReadRegStr $R1 ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "UninstallString"
  ${If} $R1 == ""
    Return
  ${EndIf}

  ;Run uninstaller
  HideWindow
  ClearErrors

  ExecWait '"$R1" _?=$INSTDIR'

  IfErrors no_remove_uninstaller

  IfFileExists "$INSTDIR\uninstall.exe" 0 no_remove_uninstaller
    Delete "$R1"
    RMDir $INSTDIR

  no_remove_uninstaller:
FunctionEnd

Function PageSkipPre
  ${If} $PerformUpdate == 1
    Abort
  ${ElseIf} $PreviousVersion != ""
    Abort
  ${EndIf}
FunctionEnd

;;; Used during upgrade to skip most pages
Function PageFastUpdatePre
  ${If} $PerformUpdate == 1
    Abort
  ${EndIf}
FunctionEnd

Function PageComponentsPre
!if "${PRODUCT_PROGID}" != "VLC"
  ; redesign: brand layer, the components page shows only when asked for: "Customize" on the
  ; welcome page, or "change settings" on the reinstall page; otherwise the install is
  ; "Recommended" (the desktop shortcut is chosen on the welcome page)
  ${If} $ReinstallType == 2
  ${OrIf} $CustomizeInstall == ${BST_CHECKED}
    Return
  ${EndIf}
  Abort
!endif
  ClearErrors
  ReadRegStr $0 ${MEMENTO_REGISTRY_ROOT} `${MEMENTO_REGISTRY_KEY}` MementoSectionUsed
  ; Backward compatibility:
  ; Don't skip the components page until Memento was able to save the user choices.
  IfErrors done

  ${If} $ReinstallType == 1
    Abort
  ${EndIf}

done:
FunctionEnd

!if "${PRODUCT_PROGID}" != "VLC"
; redesign: brand layer, pushes 1 when the installer's desktop shortcut exists, else 0 (#73): on
; the all-users desktop, where the installer puts it and the uninstaller removes it (a copy on the
; user's own desktop is the user's, never counted or touched); a 0.x beta's "Cone" shortcut
; counts, the install replaces it with the new name
Function DesktopShortcutExists
  Push $1
  StrCpy $1 0
  SetShellVarContext all
  ${If} ${FileExists} "$DESKTOP\${PRODUCT_NAME}.lnk"
    StrCpy $1 1
  ${EndIf}
!if "${PRODUCT_BETA_NAME}" != "${PRODUCT_NAME}"
  ${If} ${FileExists} "$DESKTOP\${PRODUCT_BETA_NAME}.lnk"
    StrCpy $1 1
  ${EndIf}
!endif
  SetShellVarContext current
  Exch $1
FunctionEnd

; redesign: brand layer, two boxes under the welcome text: "Create a desktop shortcut" (the
; Desktop shortcut component, ticked on a fresh install; on an upgrade or reinstall only while
; a desktop shortcut exists, see .onInit) and "Customize the installation" (shows the
; components page); in English for every language, like the file types' description
Function PageWelcomeShow
  ; the welcome text label runs to the bottom of the page: a shorter copy leaves room
  ${NSD_GetText} $mui.WelcomePage.Text $0
  ShowWindow $mui.WelcomePage.Text ${SW_HIDE}
  ${NSD_CreateLabel} 120u 55u 195u 90u "$0"
  Pop $1
  SetCtlColors $1 "${MUI_TEXTCOLOR}" "${MUI_BGCOLOR}"

  ${NSD_CreateCheckbox} 120u 150u 195u 12u "Create a desktop shortcut"
  Pop $WelcomeShortcut
  SetCtlColors $WelcomeShortcut "${MUI_TEXTCOLOR}" "${MUI_BGCOLOR}"
  SectionGetFlags ${SEC02b} $0
  IntOp $0 $0 & ${SF_SELECTED}
  ${If} $0 == ${SF_SELECTED}
    ${NSD_Check} $WelcomeShortcut
  ${EndIf}

  ${NSD_CreateCheckbox} 120u 165u 195u 12u "Customize the installation (choose components)"
  Pop $WelcomeCustomize
  SetCtlColors $WelcomeCustomize "${MUI_TEXTCOLOR}" "${MUI_BGCOLOR}"
  ${If} $CustomizeInstall == ${BST_CHECKED}
    ${NSD_Check} $WelcomeCustomize
  ${EndIf}
FunctionEnd

Function PageWelcomeLeave
  ${NSD_GetState} $WelcomeShortcut $0
  ${If} $0 == ${BST_CHECKED}
    !insertmacro SelectSection ${SEC02b}
  ${Else}
    !insertmacro UnselectSection ${SEC02b}
  ${EndIf}
  ${NSD_GetState} $WelcomeCustomize $CustomizeInstall
FunctionEnd
!endif

Function PageDirectoryPre
  ${If} $ReinstallType != ""
    Abort
  ${EndIf}
FunctionEnd

Function .OnInstSuccess
    ${MementoSectionSave}
FunctionEnd

;; End function
Section -Post
  WriteUninstaller "$INSTDIR\uninstall.exe"
  !insertmacro RegOwnStr "${PRODUCT_DIR_REGKEY}" "" "InstallDir" "$INSTDIR"
  !insertmacro RegOwnStr "${PRODUCT_DIR_REGKEY}" "" "Version" "${VERSION}"
  !insertmacro RegOwnStr "${PRODUCT_DIR_REGKEY}" "" "" "$INSTDIR\${PRODUCT_EXE}"

  ; the uninstall key is ${PRODUCT_UNINST_ROOT_KEY} (HKLM)
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "DisplayName" "${PRODUCT_DISPLAY_NAME}"
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "UninstallString" '"$INSTDIR\uninstall.exe"'
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "InstallLocation" "$INSTDIR"
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "DisplayIcon" "$INSTDIR\${PRODUCT_EXE}"
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "DisplayVersion" "${PRODUCT_VERSION}"
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "URLInfoAbout" "${PRODUCT_WEB_SITE}"
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "Publisher" "${PRODUCT_PUBLISHER}"
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "VersionMajor" "@BRAND_VERSION_MAJOR@"
  !insertmacro RegOwnStr "${PRODUCT_UNINST_KEY}" "" "VersionMinor" "@BRAND_VERSION_MINOR@"
!if "${PRODUCT_PROGID}" != "VLC"
  ; redesign: brand layer, the size Settings > Apps shows (KB)
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  !insertmacro RegOwnDWORD "${PRODUCT_UNINST_KEY}" "" "EstimatedSize" $0
  ; the last recorded write (the language and Memento's choices that follow go into the own keys
  ; ${PRODUCT_DIR_REGKEY} and the uninstall key, which the record removes whole)
  !insertmacro ConeRegCloseRecord
!endif
SectionEnd

;;;;;;;;;;;;;;;;;;;;;;;;
; Uninstaller sections ;
;;;;;;;;;;;;;;;;;;;;;;;;

Section "un.$(Name_Section91)" SEC91
  SectionIn 1 2 3 RO
  SetShellVarContext all

!if "${PRODUCT_PROGID}" != "VLC"
  ; redesign: brand layer, exactly the registry keys and values the installer recorded
  ; (helpers/registry.nsh, INSTALLER_NOTES.md section 7); no key is removed by name
  Call un.ConeRegRemove
  ; then the values older Cone installers left without a record (never a key): Open with, the
  ; AutoPlay events and Default apps
  !insertmacro MacroAllExtensions UnRegisterExtensionSection
  !insertmacro MacroSkinExtensions UnRegisterExtensionSection
  !insertmacro ConeUnAutoplayEventValue PlayDVDMovieOnArrival PlayDVDMovieOnArrival
  !insertmacro ConeUnAutoplayEventValue PlayCDAudioOnArrival PlayCDAudioOnArrival
  !insertmacro ConeUnAutoplayEventValue PlayVideoCDMovieOnArrival PlayVCDMovieOnArrival
  !insertmacro ConeUnAutoplayEventValue PlaySuperVideoCDMovieOnArrival PlaySVCDMovieOnArrival
  !insertmacro ConeUnAutoplayEventValue PlayDVDAudioOnArrival PlayDVDAudioOnArrival
  !insertmacro ConeUnAutoplayEventValue PlayVideoFilesOnArrival PlayVideoFilesOnArrival
  !insertmacro ConeUnAutoplayEventValue PlayMusicFilesOnArrival PlayMusicFilesOnArrival
  !insertmacro ConeUnAutoplayEventValue PlayBlurayOnArrival PlayBlurayOnArrival
  DeleteRegValue HKLM "Software\RegisteredApplications" "${PRODUCT_PROGID}"
!else
  !insertmacro MacroAllExtensions DeleteContextMenu
  !insertmacro MacroAllExtensions UnRegisterExtensionSection
  !insertmacro MacroSkinExtensions UnRegisterExtensionSection
  !insertmacro DeleteContextMenuExt "Directory"
!endif

!ifdef INSTALL_ACTIVEX
  ;remove activex plugin
@HAVE_WIN64_FALSE@ UnRegDLL "$INSTDIR\axvlc.dll"
@HAVE_WIN64_TRUE@  ExecWait '"$SYSDIR\regsvr32.exe" /s /u "$INSTDIR\axvlc.dll"'
  Delete /REBOOTOK "$INSTDIR\axvlc.dll"
!endif

  ; redesign: brand layer, the old Mozilla plugin files and key are an installed VLC's
!if "${PRODUCT_PROGID}" == "VLC"
  ;remove mozilla plugin
  Push $R0
  Push $R1
  Push $R2

  !define Index 'Line${__LINE__}'
  StrCpy $R1 "0"

  "${Index}-Loop:"

    ; Check for Key
    EnumRegKey $R0 HKLM "SOFTWARE\Mozilla" "$R1"
    StrCmp $R0 "" "${Index}-End"
    IntOp $R1 $R1 + 1
    ReadRegStr $R2 HKLM "SOFTWARE\Mozilla\$R0\Extensions" "Plugins"
    StrCmp $R2 "" "${Index}-Loop" ""

    ; old files (0.8.5 and before) that may be lying around
    Delete /REBOOTOK "$R2\npvlc.dll"
    Delete /REBOOTOK "$R2\libvlc.dll"
    Delete /REBOOTOK "$R2\vlcintf.xpt"
    Goto "${Index}-Loop"

  "${Index}-End:"
  !undef Index
  Delete /REBOOTOK "$INSTDIR\npvlc.dll"
!endif

  RMDir "$SMPROGRAMS\${PRODUCT_PUBLISHER}"
  RMDir /r $SMPROGRAMS\${PRODUCT_PUBLISHER}

  FileOpen $UninstallLog "$INSTDIR\uninstall.log" r
  UninstallLoop:
    ClearErrors
    FileRead $UninstallLog $R0
    IfErrors UninstallEnd
    Push $R0
    Call un.TrimNewLines
    Pop $R0
    Delete "$INSTDIR\$R0"
    Goto UninstallLoop
  UninstallEnd:
  FileClose $UninstallLog
  Delete "$INSTDIR\uninstall.log"
  Delete "$INSTDIR\uninstall.exe"
  Push "\"
  Call un.RemoveEmptyDirs
  RMDir "$INSTDIR"

  ; redesign: brand layer, the public profile never removes VideoLAN's key (an installed VLC's)
!if "${PRODUCT_EXE}" == "vlc.exe"
  DeleteRegKey HKLM Software\VideoLAN
!endif

  ; redesign: brand layer, the public profile's keys and values went with its record above
!if "${PRODUCT_PROGID}" == "VLC"
  DeleteRegKey HKCR Applications\${PRODUCT_EXE}
  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\App Paths\${PRODUCT_EXE}"
  DeleteRegKey HKCR AudioCD\shell\PlayWith${PRODUCT_PROGID}
  DeleteRegKey HKCR DVD\shell\PlayWith${PRODUCT_PROGID}
  DeleteRegValue HKLM "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayDVDMovieOnArrival" "${PRODUCT_PROGID}PlayDVDMovieOnArrival"
  DeleteRegKey HKLM Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}PlayDVDMovieOnArrival
  DeleteRegValue HKLM "Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayCDAudioOnArrival" "${PRODUCT_PROGID}PlayCDAudioOnArrival"
  DeleteRegKey HKLM Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}PlayCDAudioOnArrival
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayVideoCDMovieOnArrival" "${PRODUCT_PROGID}PlayVCDMovieOnArrival"
  DeleteRegKey HKLM SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}PlayVCDMovieOnArrival
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlaySuperVideoCDMovieOnArrival" "${PRODUCT_PROGID}PlaySVCDMovieOnArrival"
  DeleteRegKey HKLM SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}PlaySVCDMovieOnArrival
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayDVDAudioOnArrival" "${PRODUCT_PROGID}PlayDVDAudioOnArrival"
  DeleteRegKey HKLM SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}PlayDVDAudioOnArrival
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayVideoFilesOnArrival" "${PRODUCT_PROGID}PlayVideoFilesOnArrival"
  DeleteRegKey HKLM SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}PlayVideoFilesOnArrival
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlers\PlayMusicFilesOnArrival" "${PRODUCT_PROGID}PlayMusicFilesOnArrival"
  DeleteRegKey HKLM SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\Handlers\${PRODUCT_PROGID}PlayMusicFilesOnArrival

  DeleteRegKey HKLM Software\Clients\Media\${PRODUCT_PROGID}
  DeleteRegValue HKLM "Software\RegisteredApplications" "${PRODUCT_PROGID}"
  DeleteRegKey HKCR "${PRODUCT_PROGID}.MediaFile"
  DeleteRegKey HKCR "${PRODUCT_PROGID}.DVDMovie"
  DeleteRegKey HKCR "${PRODUCT_PROGID}.CDAudio"
  DeleteRegKey HKCR "${PRODUCT_PROGID}.VCDMovie"
  DeleteRegKey HKCR "${PRODUCT_PROGID}.SVCDMovie"
  DeleteRegKey HKCR "${PRODUCT_PROGID}.OPENFolder"
  DeleteRegKey HKCR "${PRODUCT_PROGID}.Bluray"


  DeleteRegKey HKLM \
    "SOFTWARE\MozillaPlugins\@videolan.org/vlc,version=${VLC_VERSION}"

  DeleteRegKey HKLM \
    "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!endif

  Delete "$DESKTOP\${PRODUCT_NAME}.lnk"
!if "${PRODUCT_PROGID}" != "VLC"
!if "${PRODUCT_BETA_NAME}" != "${PRODUCT_NAME}"
  ; redesign: brand layer, a beta's desktop shortcut that an upgrade could not reach
  Delete "$DESKTOP\${PRODUCT_BETA_NAME}.lnk"
!endif
!endif

!if "${PRODUCT_PROGID}" == "VLC"
  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKLM "${PRODUCT_DIR_REGKEY}"
!endif
  SetAutoClose true
SectionEnd

Section /o "un.$(Name_Section92)" SEC92
  !insertmacro delprefs
SectionEnd

