;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; NSIS installer script for vlc ;
; (http://nsis.sourceforge.net) ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; redesign: brand layer, the BRAND values come from configure --with-brand (vlc / public)
!define PRODUCT_NAME "@BRAND_PRODUCT_NAME@"
; the product's version: Cone's own in the public profile (Decision 58), VLC's in the vlc profile;
; VLC_VERSION is the engine's
!define VERSION @BRAND_VERSION@
!define PRODUCT_VERSION @BRAND_VERSION@
!define VLC_VERSION @VERSION@
!define PRODUCT_GROUP "@BRAND_COMPANY@"
!define PRODUCT_PUBLISHER "@BRAND_COMPANY@"
!define PRODUCT_WEB_SITE "@BRAND_WEBSITE@"
!define PRODUCT_DIR_REGKEY "@BRAND_REGKEY@"
; redesign: brand layer, the Settings > Apps key keeps the identity name ("Cone" in the public
; profile, redesign/RENAME_CONE_PLAYER.md R4), so an upgrade from a Cone beta finds and replaces its
; entry, the shown name being DisplayName
!if "@BRAND_PROGID@" == "VLC"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!else
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\@BRAND_PROGID@"
!endif
!define PRODUCT_UNINST_ROOT_KEY "HKLM"
!define PRODUCT_ID "@BRAND_PRODUCT_ID@"
!define PRODUCT_EXE "@BRAND_EXE@"
!define PRODUCT_INSTALL_DIR "@BRAND_INSTALL_DIR@"
; prefix of the ProgIDs, shell verbs, autoplay handlers and default programs entry the installer
; registers ("VLC" or "Cone"): Cone's are its own, so installing or removing it never touches an
; installed VLC's (redesign/CONE_RELEASE_NOTES.md)
!define PRODUCT_PROGID "@BRAND_PROGID@"
!if "${PRODUCT_PROGID}" == "VLC"
  !define PRODUCT_SHORT_NAME "VLC"
  !define PRODUCT_DESCRIPTION "VLC - The video swiss knife"
  ; the user settings folder in %APPDATA% (src/win32/dirs.c)
  !define PRODUCT_APPDATA_DIR "vlc"
  !define PRODUCT_DOC_URL "${PRODUCT_WEB_SITE}/doc/"
  !define PRODUCT_SKINS_URL "${PRODUCT_WEB_SITE}/vlc/skins.php"
  !define PRODUCT_WEBSITE_LINK "${PRODUCT_GROUP} Website"
  !define PRODUCT_BRANDING_TEXT "${PRODUCT_GROUP} ${PRODUCT_NAME}"
  !define PRODUCT_TITLE "${PRODUCT_NAME}"
  !define PRODUCT_DISPLAY_NAME "$(^Name)"
!else
  !define PRODUCT_SHORT_NAME "${PRODUCT_NAME}"
  !define PRODUCT_DESCRIPTION "${PRODUCT_NAME}, a media player based on VLC media player"
  ; the user settings folder in %APPDATA%: the identity name, the ProgID prefix
  ; "Cone", which the rename keeps (src/win32/dirs.c APP_DIR_NAME, RENAME_CONE_PLAYER.md R4)
  !define PRODUCT_APPDATA_DIR "${PRODUCT_PROGID}"
  ; the name of the 0.x betas: an upgrade removes their shortcuts and website link
  !define PRODUCT_BETA_NAME "Cone"
  ; the project page holds the documentation; no skins (Decision 63): no skins link
  !define PRODUCT_DOC_URL "${PRODUCT_WEB_SITE}#readme"
  !define PRODUCT_WEBSITE_LINK "${PRODUCT_NAME} Website"
  ; Decision 58: "Cone Player 1.0.0" in the window title and on the welcome and finish pages,
  ; "based on VLC <major version>" under every page ("based on VLC 4", not the engine's
  ; development version "4.0.0-dev"); the Windows Apps list shows "Cone Player" and its version
  !searchparse "${VLC_VERSION}" "" VLC_VERSION_MAJOR "."
  !define PRODUCT_BRANDING_TEXT "based on VLC ${VLC_VERSION_MAJOR}"
  !define PRODUCT_TITLE "${PRODUCT_NAME} ${PRODUCT_VERSION}"
  !define PRODUCT_DISPLAY_NAME "${PRODUCT_NAME}"
!endif

!define MUI_LANGDLL_REGISTRY_ROOT "HKLM"
!define MUI_LANGDLL_REGISTRY_KEY "${PRODUCT_DIR_REGKEY}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "Language"

!define MEMENTO_REGISTRY_ROOT ${PRODUCT_UNINST_ROOT_KEY}
!define MEMENTO_REGISTRY_KEY "${PRODUCT_UNINST_KEY}"

@HAVE_WIN64_TRUE@ !define VLC_64BIT_INSTALLER

ManifestDPIAware true
Unicode true

; !define INSTALL_ACTIVEX

Var ReinstallType
Var ReinstallUninstallBtn
Var PerformUpdate
Var PreviousVersion
Var PreviousVersionState
Var PreviousInstallDir
Var UninstallLog

Var 32bitUninstaller
!if "${PRODUCT_PROGID}" != "VLC"
; redesign: brand layer, the welcome page's "Create a desktop shortcut" and "Customize" boxes
Var WelcomeShortcut
Var WelcomeCustomize
Var CustomizeInstall
!endif
Var 32bitPath

;;;;;;;;;;;;;;;;;;;;;;;;;
; General configuration ;
;;;;;;;;;;;;;;;;;;;;;;;;;

Name "${PRODUCT_TITLE}"
@HAVE_WIN64_FALSE@                   OutFile ..\@BRAND_INSTALLER_NAME@-${VERSION}-win32.exe
@HAVE_WIN64_TRUE@ @HAVE_ARM64_FALSE@ OutFile ..\@BRAND_INSTALLER_NAME@-${VERSION}-win64.exe
@HAVE_WIN64_TRUE@ @HAVE_ARM64_TRUE@  OutFile ..\@BRAND_INSTALLER_NAME@-${VERSION}-winarm64.exe
InstallDir "$@PROGRAMFILES@\${PRODUCT_INSTALL_DIR}"
!ifdef NSIS_LZMA_COMPRESS_WHOLE
SetCompressor lzma
!else
SetCompressor /SOLID lzma
!endif

SetOverwrite ifdiff
CRCCheck on
BrandingText "${PRODUCT_BRANDING_TEXT}"

InstType "$(Name_InstTypeRecommended)"
InstType "$(Name_InstTypeMinimum)"
InstType "$(Name_InstTypeFull)"

RequestExecutionLevel admin
!addincludedir NSIS
!addplugindir NSIS
!include nsProcess.nsh
!include WinVer.nsh
!include FileFunc.nsh
!include MUI2.nsh
!include Memento.nsh

!insertmacro GetParameters
!insertmacro GetOptions

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; NSIS Modern User Interface configuration ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

